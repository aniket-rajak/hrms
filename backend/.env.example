# ===== Server =====
NODE_ENV=development
PORT=5000
# Single source of truth for CORS + password-reset links. Local: http://localhost:3000 (default).
# Production (Render): https://<your-app>.vercel.app — no CORS_ORIGINS needed.
FRONTEND_URL=http://localhost:3000
# Optional extra CORS origins on top of FRONTEND_URL (comma-separated), e.g. preview domains
# CORS_ORIGINS=https://preview.vercel.app

# ===== Database (MongoDB Atlas) =====
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hrms?retryWrites=true&w=majority"

# ===== JWT =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hrms

# ===== Email (transactional) =====
# Brevo HTTP API (recommended - works from Render free tier where SMTP is blocked)
EMAIL_PROVIDER=auto          # auto | brevo | smtp
BREVO_API_KEY=
EMAIL_FROM="HRMS <no-reply@example.com>"

# ===== SMTP (for Forgot Password emails - fallback when no Brevo key) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HRMS <no-reply@example.com>"

# ===== Seed =====
SEED_ADMIN_EMAIL=admin@hrms.com
SEED_ADMIN_PASSWORD=Admin@123
