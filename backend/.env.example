# ===== Server =====
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ===== Database (MySQL) =====
DATABASE_URL="mysql://root:password@localhost:3306/hrms"

# ===== JWT =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hrms

# ===== SMTP (for Forgot Password emails - fill with your provider) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HRMS <no-reply@example.com>"

# ===== Seed =====
SEED_ADMIN_EMAIL=admin@hrms.com
SEED_ADMIN_PASSWORD=Admin@123
